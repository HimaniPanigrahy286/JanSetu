# JanSetu Firebase Configuration
# Replace these values with your Firebase Project credentials if you wish to enable live Firebase Authentication & Firestore.
# When omitted, JanSetu automatically operates in offline/local mock mode.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
